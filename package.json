{
  "name": "@truthlocks/maip-github-action",
  "version": "1.2.0",
  "private": false,
  "description": "Create signed MAIP receipts for GitHub events and verify their signatures",
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && ncc build dist/index.js -o dist --source-map --license licenses.txt",
    "build:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/github": "^6.0.0",
    "@octokit/rest": "^20.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vercel/ncc": "^0.38.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "homepage": "https://docs.truthlocks.com/guides/protect-action",
  "repository": {
    "type": "git",
    "url": "https://github.com/truthlocks/truthlock.git",
    "directory": "packages/maip-github-action"
  },
  "bugs": {
    "url": "https://github.com/truthlocks/truthlock/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md"
  ]
}
